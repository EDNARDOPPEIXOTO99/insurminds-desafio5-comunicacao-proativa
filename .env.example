# Copie este arquivo para ".env" e preencha com suas chaves.

# --- OpenWeatherMap (OBRIGATÓRIO — fonte de dados meteorológicos) ---
# Chave gratuita: https://openweathermap.org/api (cadastro grátis, sem cartão)
OPENWEATHER_API_KEY=coloque_sua_chave_aqui

# --- Provedor de LLM para geração das mensagens ---
# "google" (RECOMENDADO - gratuito) | "anthropic" | "openai" | "ollama" (100% local)
LLM_PROVIDER=google

GOOGLE_API_KEY=coloque_sua_chave_aqui
GOOGLE_MODEL=gemini-flash-lite-latest

# --- Ollama (100% LOCAL - sem chave, sem custo) ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (Claude, pago) ---
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (GPT, pago) ---
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Regras de negócio (opcional, já vem com valores padrão razoáveis) ---
LIMIAR_CHUVA_MM=10
LIMIAR_VENTO_MS=12
